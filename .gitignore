# Paid or restricted references
references/paid/*
!references/paid/.gitkeep

# Temporary meshes and scratch geometry
*_temp.stl
*_scratch.stl
*_healed.stl
*_decimated.stl
*_repair.stl
*_repair.obj
*_repair.glb
*.tmp.stl
*.tmp.obj
*.tmp.glb

# Phase 1 generated artifacts. Small, intentional test fixtures require
# an explicit force-add and are checked by scripts/check_output_policy.py.
*.stl
*.STL
*.3mf
*.3MF
*.png
*.PNG
*.obj
*.OBJ
*.glb
*.GLB
*.log
*.log.*

# Local-first generated project workspaces
/workspace/**
!/workspace/.gitkeep

# Owner fit-validation inputs. Keep only placeholder templates in Git under
# owner-validation/templates; filled specifications and notes belong here.
/owner-validation/local/**

# Slicer temp and export junk
*.3mf.cache
*.gcode
*.bgcode
*.sl1
*.photon
*.ctb

# Evidence exports are ordinary local records. The canonical commands write
# them under workspace/, while these patterns also protect manual copies.
*.fit-result.json
*.fit-evidence.json
*.physical-fit.json
*.physical-fit-evidence.json
*.evidence.json

# Python
app/node_modules/
app/dist/
.playwright-cli/
output/playwright/
__pycache__/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Editors and OS files
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
Thumbs.db
.DS_Store

# Bambu Studio help/capability probe writes this local status record.
/result.json
