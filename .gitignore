# Paid or restricted references
references/paid/*
!references/paid/.gitkeep

# Temporary meshes and scratch geometry
*_temp.stl
*_scratch.stl
*_healed.stl
*_decimated.stl
*_repair.stl
*_repair.obj
*_repair.glb
*.tmp.stl
*.tmp.obj
*.tmp.glb

# Phase 1 generated artifacts. Small, intentional test fixtures require
# an explicit force-add and are checked by scripts/check_output_policy.py.
*.stl
*.STL
*.3mf
*.3MF
*.png
*.PNG
*.obj
*.OBJ
*.glb
*.GLB
*.log
*.log.*

# Local-first generated project workspaces
/workspace/**
!/workspace/.gitkeep

# Slicer temp and export junk
*.3mf.cache
*.gcode
*.bgcode
*.sl1
*.photon
*.ctb

# Python
__pycache__/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Editors and OS files
.idea/
.vscode/
Thumbs.db
.DS_Store
