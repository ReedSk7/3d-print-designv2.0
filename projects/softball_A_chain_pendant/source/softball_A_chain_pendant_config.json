{
  "project_stem": "softball_A_chain_pendant",
  "version": "v01",
  "task_mode": "mesh_cleanup_and_remodel",
  "printer": "Bambu Lab P2S with AMS",
  "units": "mm",
  "orientation": "Z+ up, flat back on bed",
  "visual_reference_only": true,
  "size_variants": {
    "large": {
      "target_height_mm": 104,
