{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reedsk7.github.io/parametric-part-workbench/schemas/physical-fit-evidence-v1.schema.json",
  "title": "Immutable complete-part physical-fit evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_kind",
    "created_at",
    "full_part",
    "bindings",
    "confirmation",
    "defensible_workflow_state",
    "claims",
    "not_evaluated"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_kind": { "const": "physical_fit_confirmation" },
    "created_at": { "type": "string", "format": "date-time" },
    "full_part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_version",
        "generator",
        "generation_mode",
        "generation_workflow_state"
      ],
      "properties": {
        "project_id": { "$ref": "#/$defs/nonempty" },
        "project_version": { "$ref": "#/$defs/nonempty" },
        "generator": { "$ref": "#/$defs/generator" },
        "generation_mode": { "const": "full_part" },
        "generation_workflow_state": { "const": "full_part_exported" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "stl", "scad", "specification_snapshot"],
      "properties": {
        "manifest": { "$ref": "#/$defs/file_binding" },
        "stl": { "$ref": "#/$defs/file_binding" },
        "scad": { "$ref": "#/$defs/file_binding" },
        "specification_snapshot": { "$ref": "#/$defs/file_binding" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_by",
        "confirmed_at",
        "interface_results",
        "measured_dimensions",
        "notes"
      ],
      "properties": {
        "confirmed_by": { "$ref": "#/$defs/nonempty" },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "interface_results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interface_result" }
        },
        "measured_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/measured_dimension" }
        },
        "notes": { "type": "string" }
      }
    },
    "defensible_workflow_state": { "const": "physical_fit_confirmed" },
    "claims": {
      "const": ["physical fit for the recorded protected interfaces"]
    },
    "not_evaluated": {
      "const": [
        "durability",
        "load rating",
        "temperature performance",
        "safety qualification",
        "regulatory or product certification"
      ]
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "decimal": {
      "oneOf": [
        { "type": "number" },
        { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
      ]
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "version": { "$ref": "#/$defs/nonempty" }
      }
    },
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$)).+"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "interface_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_parameter",
        "acceptance_criterion",
        "observed_result",
        "passed",
        "notes"
      ],
      "properties": {
        "interface_parameter": { "$ref": "#/$defs/nonempty" },
        "acceptance_criterion": { "$ref": "#/$defs/nonempty" },
        "observed_result": { "$ref": "#/$defs/nonempty" },
        "passed": { "const": true },
        "notes": { "type": "string" }
      }
    },
    "measured_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_name",
        "measured_value",
        "units",
        "measurement_source"
      ],
      "properties": {
        "parameter_name": { "$ref": "#/$defs/nonempty" },
        "measured_value": { "$ref": "#/$defs/decimal" },
        "units": { "enum": ["mm", "inch"] },
        "measurement_source": { "$ref": "#/$defs/nonempty" },
        "notes": { "type": "string" }
      }
    }
  }
}
